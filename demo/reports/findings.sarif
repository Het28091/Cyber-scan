{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secaudit",
          "version": "0.3.0"
        }
      },
      "results": [
        {
          "ruleId": "PY-DYNAMIC-EXEC",
          "level": "warning",
          "message": {
            "text": "Dynamic execution can interpret untrusted input. This is a syntax-based candidate, not data-flow proof."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.py"
                },
                "region": {
                  "startLine": 6
                }
              }
            }
          ]
        },
        {
          "ruleId": "PY-SHELL",
          "level": "warning",
          "message": {
            "text": "shell=True enables shell interpretation."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.py"
                },
                "region": {
                  "startLine": 8
                }
              }
            }
          ]
        },
        {
          "ruleId": "CONFIG-DEBUG",
          "level": "warning",
          "message": {
            "text": "Debug setting is enabled."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.py"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ]
        },
        {
          "ruleId": "SECRET-LITERAL",
          "level": "warning",
          "message": {
            "text": "A credential-like assignment contains a literal. Value intentionally discarded."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.py"
                },
                "region": {
                  "startLine": 4
                }
              }
            }
          ]
        },
        {
          "ruleId": "API-SECURITY",
          "level": "warning",
          "message": {
            "text": "GET /public has no non-empty security requirement; public endpoints may be intentional."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "openapi.json"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
