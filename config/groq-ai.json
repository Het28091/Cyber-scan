{
  "mode": "connected-ai",
  "source": "demo/source",
  "target": "",
  "output": "runs",
  "modules": ["source", "secrets", "config"],
  "ai": {
    "enabled": true,
    "provider": "openai-compatible",
    "endpoint": "https://api.groq.com/openai/v1",
    "model": "llama-3.1-8b-instant",
    "approved_ips": [],
    "api_key_env": "SECAUDIT_API_KEY",
    "failure_policy": "required",
    "request_budget": 2,
    "token_budget": 8192,
    "output_tokens": 512,
    "timeout": 30
  }
}
